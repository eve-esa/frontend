VITE_API_URL=
# Injected at build time by the deploy workflows. Leave empty locally: the
# version footer is hidden when both values are missing.
VITE_APP_VERSION=
VITE_APP_COMMIT=
VITE_CONTACT_URL=
VITE_PRIVACY_POLICY_URL=
VITE_ABOUT_US_URL=
# Feature flags — LOCAL DEVELOPMENT ONLY.
#
# In every deployed environment these arrive as window.__EVE_CONFIG__, injected into
# index.html at publish time by .github/actions/inject-runtime-config, because one build is
# promoted unchanged across environments and a baked-in value could not differ between them.
# The VITE_ variables below are the fallback for `yarn dev`, where nothing injects.
#
# A flag exists to turn a feature OFF: leave one blank and the feature is on.
VITE_FEATURE_MODEL_PICKER=
VITE_FEATURE_CUSTOM_MODELS=
VITE_FEATURE_STREAMING=
VITE_FEATURE_CLASSIFICATION_FILTERS=

# Opening-scope flags, default OFF, set true locally. These six invert the rule above: they are
# hidden unless an environment opts in, so leaving them blank removes all six features from
# `yarn dev`. The root docker-compose.yml sets the same six on the frontend service.
VITE_FEATURE_ARTIFACTS=true
VITE_FEATURE_TOOLKITS=true
VITE_FEATURE_PRIVATE_COLLECTIONS=true
VITE_FEATURE_ATTACHMENTS=true
VITE_FEATURE_ANSWERED_BY=true
VITE_FEATURE_BETA_BADGE=true
VITE_FEATURE_WELCOME_DIALOG=true

# OIDC provider coordinates. Same runtime-config route as the flags above: injected in
# deployed environments, VITE_ fallback for local dev. For the local Keycloak stack use:
#   VITE_AUTH_ISSUER=http://localhost:8080/realms/eve
#   VITE_AUTH_CLIENT_ID=eve-frontend
# The scope defaults to "openid profile email" when left blank.
VITE_AUTH_ISSUER=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_SCOPE=
