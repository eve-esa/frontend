VITE_API_URL=
# Injected at build time by the deploy workflows. Leave empty locally: the
# version footer is hidden when both values are missing.
VITE_APP_VERSION=
VITE_APP_COMMIT=
VITE_CONTACT_URL=
VITE_PRIVACY_POLICY_URL=
VITE_ABOUT_US_URL=
# Feature flags, LOCAL DEVELOPMENT ONLY.
#
# In every deployed environment these arrive as window.__EVE_CONFIG__, injected into
# index.html at publish time by .github/actions/inject-runtime-config, because one build is
# promoted unchanged across environments and a baked-in value could not differ between them.
# The VITE_ variables below are the fallback for `yarn dev`, where nothing injects.
#
# A flag exists to turn a feature OFF: leave one blank and the feature is on.
VITE_FEATURE_MODEL_PICKER=
VITE_FEATURE_CUSTOM_MODELS=
VITE_FEATURE_STREAMING=
VITE_FEATURE_CLASSIFICATION_FILTERS=
VITE_FEATURE_API_KEYS=
# Off sends chat turns to the classic retrieve-then-generate pipeline and hides Toolkits.
VITE_FEATURE_AGENTIC_CHAT=

# Opening-scope flags, default OFF, set true locally. These eight invert the rule above: they are
# hidden unless an environment opts in, so leaving them blank removes all eight features from
# `yarn dev`. The root docker-compose.yml sets the same eight on the frontend service.
VITE_FEATURE_ARTIFACTS=true
VITE_FEATURE_TOOLKITS=true
VITE_FEATURE_PRIVATE_COLLECTIONS=true
VITE_FEATURE_ATTACHMENTS=true
VITE_FEATURE_ANSWERED_BY=true
VITE_FEATURE_BETA_BADGE=true
VITE_FEATURE_WELCOME_DIALOG=true
VITE_FEATURE_STREAM_STATUS_NOTICES=true

# "Report a bug" entries and dialog. Default OFF like the flags above; needs the backend
# POST /bug-reports and is most useful with the browser telemetry below turned on.
VITE_FEATURE_REPORT_BUG=

# Country and institution in the profile dialog. Default OFF like the flags above; needs a backend
# whose GET /users/me and PATCH /users carry both fields.
VITE_FEATURE_PROFILE_FIELDS=

# System, Light and Dark in the profile menu, and the light theme. Default OFF like the flags above:
# off, the app stays dark whatever the operating system prefers.
VITE_FEATURE_THEME_SWITCH=

# Answers rendered by Streamdown (Mermaid diagrams, KaTeX, self-healing streamed markdown) instead of
# react-markdown. Default OFF like the flags above: off, answers render exactly as before.
VITE_FEATURE_STREAMDOWN=

# The inline agent steps block above each agentic answer, in place of the streamed status
# notices, the tool chips and the footer Trace button. Default OFF: the chat stays as before.
VITE_FEATURE_AGENT_STEPS=

# With FEATURE_AGENT_STEPS on, keeps the footer Trace button and the agent trace side panel as a
# debugging view. Default OFF. Ignored with the agent steps off (the Trace button is always there).
VITE_FEATURE_TRACE_SIDEBAR=

# Numbered source markers in agentic answers, a source card on click and the sources list under
# the answer, for turns whose backend sends citations (backend FEATURE_INLINE_CITATIONS). Default
# OFF: every answer keeps the Sources button.
VITE_FEATURE_INLINE_CITATIONS=

# The footer Sandbox button and panel: sandbox status, live sandbox files and the conversation's
# saved files. A debugging view; needs the backend FEATURE_SANDBOX_API. Default OFF.
VITE_FEATURE_SANDBOX_EXPLORER=

# The Settings page at /settings/<section> (Profile, Appearance, Models, Usage, API keys, Account),
# opened from the user menu. On, the user menu holds Settings, About us, Contact us, Privacy policy
# and Log out. Default OFF: the user menu and its dialogs stay as they are.
VITE_FEATURE_SETTINGS_PAGE=

# The Usage section of the Settings page (token budget, message count, characters, CO2eq). Read only
# with FEATURE_SETTINGS_PAGE on. Default OFF: the section is hidden and CO2eq stays in the user menu.
VITE_FEATURE_SETTINGS_USAGE=

# The composer redesign: on a phone (below the md breakpoint) the composer sits at the bottom of the
# empty chat with the logo and three suggestions above it, the header holds a model field that opens
# a bottom sheet and a New chat button, and the model picker leaves the composer. On every width the
# Attach, Control Panel and Send buttons are 44 px squares, and the disclaimer is one short line with
# a Learn more dialog, shown after the first answer only. Default OFF: the composer is as before.
VITE_FEATURE_MOBILE_COMPOSER=

# OIDC provider coordinates. Same runtime-config route as the flags above: injected in
# deployed environments, VITE_ fallback for local dev. For the local Keycloak stack use:
#   VITE_AUTH_ISSUER=http://localhost:8080/realms/eve
#   VITE_AUTH_CLIENT_ID=eve-frontend
# The scope defaults to "openid profile email" when left blank.
VITE_AUTH_ISSUER=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_SCOPE=

# Browser telemetry to the ClickStack (HyperDX) collector. Same runtime-config route as above.
# Leave the endpoint blank and telemetry is off: the SDK is never downloaded. For the local
# clickstack compose profile use:
#   VITE_OBSERVABILITY_ENDPOINT=http://localhost:4318
#   VITE_OBSERVABILITY_INGEST_KEY=<browser ingest key from the HyperDX UI>
#   VITE_OBSERVABILITY_UI_URL=<HyperDX UI URL of the clickstack profile>
# Privacy mode: off (no replay), mask (default: replay with all text and inputs masked),
# on_demand (no replay until triggered), clear (replay unmasked except [data-private]).
VITE_OBSERVABILITY_ENDPOINT=
VITE_OBSERVABILITY_INGEST_KEY=
VITE_OBSERVABILITY_UI_URL=
VITE_OBSERVABILITY_ENVIRONMENT=
VITE_OBSERVABILITY_PRIVACY_MODE=
VITE_OBSERVABILITY_CONSOLE_CAPTURE=
