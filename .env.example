VITE_API_URL=
# Injected at build time by the deploy workflows. Leave empty locally: the
# version footer on the login page is hidden when both values are missing.
VITE_APP_VERSION=
VITE_APP_COMMIT=
VITE_CONTACT_URL=
VITE_PRIVACY_POLICY_URL=
VITE_ABOUT_US_URL=
# Feature flags — LOCAL DEVELOPMENT ONLY.
#
# In every deployed environment these arrive as window.__EVE_CONFIG__, injected into
# index.html at publish time by .github/actions/inject-runtime-config, because one build is
# promoted unchanged across environments and a baked-in value could not differ between them.
# The VITE_ variables below are the fallback for `yarn dev`, where nothing injects.
#
# A flag exists to turn a feature OFF: leave one blank and the feature is on.
VITE_FEATURE_MODEL_PICKER=
VITE_FEATURE_CUSTOM_MODELS=
VITE_FEATURE_STREAMING=
VITE_FEATURE_CLASSIFICATION_FILTERS=

# The exception, defaulting to OFF: this decides who may create an account rather than what an
# account can do. Off means not published at all — the signup route is not registered — and the
# backend refuses POST /signup (FEATURE_SELF_SIGNUP there).
VITE_FEATURE_SELF_SIGNUP=
